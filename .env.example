# ---------------------------------------------------------------------------
# Copy to .env for local use. In production these are GitHub Actions
# secrets/variables and Render environment variables, never a committed file.
# ---------------------------------------------------------------------------

ENVIRONMENT=local                 # local | ci | production
LOG_LEVEL=INFO

# --- Database (Neon) -------------------------------------------------------
# Two URLs, and they are NOT interchangeable.
#   DATABASE_URL        -> the POOLED string (host contains "-pooler").
#                          Used by the app and every cron job. Neon's free
#                          compute suspends after 5 idle minutes and the
#                          pooler absorbs the reconnect.
#   DATABASE_DIRECT_URL -> the unpooled string, for schema changes only.
#                          PgBouncer in transaction mode cannot run DDL
#                          reliably. Optional: if unset, "-pooler" is stripped
#                          from DATABASE_URL.
DATABASE_URL=
DATABASE_DIRECT_URL=

# --- Mode ------------------------------------------------------------------
# signal_only : analyse, journal, send to Telegram. Nothing is tracked.
# paper       : also open a simulated position, so the journal can score the
#               prediction in R. Recommended - without it you never find out
#               whether the signals were any good.
#
# There is no live mode. This project holds no exchange credentials and
# contains no code that could place an order.
TRADING_MODE=paper

# --- Telegram: the delivery channel AND the user interface -----------------
# There is no web frontend; the bot is the dashboard.
#
# 1. Create a bot with @BotFather -> TELEGRAM_BOT_TOKEN
# 2. Message your bot, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates -> TELEGRAM_CHAT_ID
# 3. Generate a webhook secret:
#    python -c "import secrets; print(secrets.token_urlsafe(32))"
# 4. After deploying, run: tradingbot telegram-setup
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Required for interactive commands. The webhook URL is effectively public, so
# this shared secret is what stops anyone who guesses it from injecting
# commands. If unset, the webhook rejects ALL traffic (push signals still work).
TELEGRAM_WEBHOOK_SECRET=

# Extra chat ids allowed to command the bot, comma-separated. Defaults to
# TELEGRAM_CHAT_ID alone. An unconfigured bot answers nobody.
TELEGRAM_ALLOWED_CHAT_IDS=

# Public HTTPS URL of the deployed API, used to register the webhook.
# Telegram will not accept localhost.
PUBLIC_BASE_URL=

# --- Reasoning layer (Phase 2, not yet wired in) ---------------------------
ANTHROPIC_API_KEY=
REASONING_ENABLED=false

# --- Paths -----------------------------------------------------------------
# CONFIG_DIR must hold universe.yaml and risk.yaml. Set automatically in CI and
# baked into the Docker image; only needed locally if running from outside the
# repository root.
# CONFIG_DIR=./config
# CACHE_DIR must be writable. Defaults to /tmp/tradingbot-cache.
# CACHE_DIR=/tmp/tradingbot-cache
