# ---------------------------------------------------------------------------
# Copy to .env for local use. In production these are set as GitHub Actions
# secrets/variables and Render environment variables, never as a file.
# ---------------------------------------------------------------------------

ENVIRONMENT=local                 # local | ci | production
LOG_LEVEL=INFO

# --- Database (Neon) -------------------------------------------------------
# Two URLs, and they are NOT interchangeable.
#   DATABASE_URL        -> the POOLED string (host contains "-pooler").
#                          Used by the app and by every cron job. Neon's free
#                          compute suspends after 5 idle minutes, and the
#                          pooler absorbs the reconnect.
#   DATABASE_DIRECT_URL -> the unpooled string. Needed only for schema
#                          changes: PgBouncer in transaction mode cannot run
#                          DDL reliably. Optional - if unset, the pooled URL
#                          has "-pooler" stripped from it.
DATABASE_URL=
DATABASE_DIRECT_URL=

# --- Trading mode ----------------------------------------------------------
# signal_only : analyse, journal and notify. No broker is contacted at all.
# paper       : simulate fills against the paper broker.
# live        : place real orders on WEEX.
#
# TWO switches must agree before real money can move. Setting one alone does
# nothing, so a single stray variable in a deploy config cannot arm the bot.
# Live mode additionally refuses to start without all three WEEX credentials,
# and refuses to place an order until `tradingbot verify-credentials` passes.
TRADING_MODE=signal_only
LIVE_TRADING_ENABLED=false

# --- WEEX (execution + live quotes; market data endpoints are public) ------
# Required for paper and live mode, because the risk gate needs a real spread
# and funding rate and FAILS CLOSED without them.
WEEX_API_KEY=
WEEX_API_SECRET=
WEEX_API_PASSPHRASE=

# --- Telegram delivery -----------------------------------------------------
# Optional but strongly recommended: it is the only push channel, and the API
# sleeps on the free tier. Get the chat id by messaging the bot and opening
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Reasoning layer (Phase 2, not yet wired in) --------------------------
ANTHROPIC_API_KEY=
REASONING_ENABLED=false

# --- Paths -----------------------------------------------------------------
# CONFIG_DIR must point at the directory holding universe.yaml and risk.yaml.
# Set automatically in CI and baked into the Docker image; only needed locally
# if you run from outside the repository root.
# CONFIG_DIR=./config
# CACHE_DIR must be writable. Defaults to /tmp/tradingbot-cache.
# CACHE_DIR=/tmp/tradingbot-cache
